{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/analyze-project-claims/study-config.schema.json",
  "title": "Analyze Project Claims cross-project study configuration",
  "type": "object",
  "required": [
    "schema_version",
    "study_id",
    "protocol_version",
    "phase",
    "evidence_role",
    "claim_boundary",
    "paper_table_eligible",
    "general_reliability_proved",
    "conditions",
    "agent_families",
    "repeats",
    "projects",
    "analysis"
  ],
  "properties": {
    "schema_version": {"const": "APC_CROSS_PROJECT_RELIABILITY_CONFIG_V1"},
    "study_id": {"type": "string", "minLength": 1},
    "protocol_version": {"type": "string", "minLength": 1},
    "phase": {"enum": ["workflow_dry_run", "development_pilot", "confirmatory"]},
    "evidence_role": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1},
    "paper_table_eligible": {"const": false},
    "general_reliability_proved": {"const": false},
    "conditions": {"type": "array", "minItems": 3},
    "agent_families": {"type": "array", "minItems": 2},
    "repeats": {"type": "array", "minItems": 1},
    "projects": {"type": "array"},
    "analysis": {
      "type": "object",
      "required": ["primary_unit"],
      "properties": {"primary_unit": {"const": "project"}}
    }
  },
  "additionalProperties": true
}
