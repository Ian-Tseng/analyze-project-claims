{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ian-Tseng/analyze-project-claims/skill-quality-evaluation-result.schema.json",
  "title": "Skill Quality Evaluation Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "evaluation_id", "manifest_digest_sha256",
    "fixture_results", "summary", "classification", "executed_at_utc",
    "result_digest_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "skill-quality-evaluation-result"},
    "evaluation_id": {"$ref": "#/$defs/identifier"},
    "manifest_digest_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/fixture_result"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "classification": {"$ref": "#/$defs/classification"},
    "executed_at_utc": {"type": "string", "format": "date-time"},
    "result_digest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
    "fixture_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id", "fixture_digest_sha256", "baseline_replay_matches",
        "baseline_replay_total", "problem_cluster_correct", "owner_disposition",
        "owner_authoring_seconds", "baseline_score_basis_points",
        "candidate_score_basis_points", "maximum_regression_basis_points",
        "unauthorized_outbound_actions"
      ],
      "properties": {
        "fixture_id": {"$ref": "#/$defs/identifier"},
        "fixture_digest_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_replay_matches": {"type": "integer", "minimum": 0, "maximum": 100},
        "baseline_replay_total": {"type": "integer", "minimum": 1, "maximum": 100},
        "problem_cluster_correct": {"type": "boolean"},
        "owner_disposition": {"enum": ["accepted", "deferred", "rejected"]},
        "owner_authoring_seconds": {"type": "integer", "minimum": 0, "maximum": 604800},
        "baseline_score_basis_points": {"$ref": "#/$defs/basis_points"},
        "candidate_score_basis_points": {"$ref": "#/$defs/basis_points"},
        "maximum_regression_basis_points": {"$ref": "#/$defs/basis_points"},
        "unauthorized_outbound_actions": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_count", "baseline_replay_reproducibility_basis_points",
        "false_problem_cluster_basis_points", "primary_improvement_basis_points",
        "maximum_observed_regression_basis_points", "total_owner_authoring_seconds",
        "unauthorized_outbound_actions"
      ],
      "properties": {
        "receipt_count": {"type": "integer", "minimum": 1, "maximum": 256},
        "baseline_replay_reproducibility_basis_points": {"$ref": "#/$defs/basis_points"},
        "false_problem_cluster_basis_points": {"$ref": "#/$defs/basis_points"},
        "primary_improvement_basis_points": {"type": "integer", "minimum": -10000, "maximum": 10000},
        "maximum_observed_regression_basis_points": {"$ref": "#/$defs/basis_points"},
        "total_owner_authoring_seconds": {"type": "integer", "minimum": 0},
        "unauthorized_outbound_actions": {"type": "integer", "minimum": 0}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_codes"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    }
  }
}
