{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ian-Tseng/personal-agent-skills/schemas/lifecycle-phase-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "protocol_version", "run_id", "sequence", "phase", "status", "evidence_method", "started_at", "ended_at", "summary", "pre_identity", "post_identity", "mutations", "network_destinations", "artifacts", "error_code", "previous_receipt_digest", "receipt_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "LifecyclePhaseReceipt"},
    "protocol_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^plv-[a-z0-9-]{1,64}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 64},
    "phase": {"type": "string", "minLength": 1, "maxLength": 64},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
    "evidence_method": {"enum": ["executed_test", "schema_validated", "inspected", "not_tested"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "pre_identity": {"type": "object"},
    "post_identity": {"type": "object"},
    "mutations": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 1024}},
    "network_destinations": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 200}},
    "artifacts": {"type": "object"},
    "error_code": {"type": ["string", "null"], "maxLength": 80},
    "previous_receipt_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
