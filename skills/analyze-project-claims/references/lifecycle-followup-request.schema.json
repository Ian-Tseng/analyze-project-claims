{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ian-Tseng/analyze-project-claims/schemas/lifecycle-followup-request-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "protocol_version", "source_receipt_digest", "interpretation_digest", "run_id", "product", "finding", "finding_signature", "required_evidence", "allowed_action", "actions_not_authorized", "iteration", "max_cycles", "previous_request_digest", "request_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "VerificationFollowupRequest"},
    "protocol_version": {"const": "1.0"},
    "source_receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "interpretation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "run_id": {"type": "string", "pattern": "^plv-[a-z0-9-]{1,64}$"},
    "product": {"type": "object"},
    "finding": {"type": "object"},
    "finding_signature": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "required_evidence": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "maxLength": 500}},
    "allowed_action": {"const": "read_only_plan"},
    "actions_not_authorized": {"type": "array", "contains": {"const": "execute"}},
    "iteration": {"type": "integer", "minimum": 1, "maximum": 3},
    "max_cycles": {"const": 3},
    "previous_request_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
