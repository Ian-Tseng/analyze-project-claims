{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ian-Tseng/analyze-project-claims/blob/main/skills/analyze-project-claims/references/managed-skill-policy.schema.json",
  "title": "Ian-Tseng managed skill repair policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "enabled",
    "repository",
    "skill",
    "validation",
    "triage",
    "environments",
    "publication",
    "compatibility",
    "workflow"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "protocol": {"const": "ian-tseng-managed-skill-repair/v1"},
    "enabled": {"type": "boolean"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "full_name", "default_branch"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "full_name": {"type": "string", "pattern": "^Ian-Tseng/[A-Za-z0-9_.-]+$"},
        "default_branch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "package_roots", "allowed_roots", "denied_paths", "version_files"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "package_roots": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}},
        "allowed_roots": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string"}},
        "denied_paths": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}},
        "version_files": {"type": "array", "minItems": 2, "maxItems": 12, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": {"enum": ["python-unittest-package-v1", "python-pytest-package-v1"]}
      }
    },
    "triage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "actors"],
      "properties": {
        "label": {"const": "managed-repair-ready"},
        "actors": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"const": "Ian-Tseng"}}
      }
    },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "publish"],
      "properties": {
        "agent": {"const": "managed-repair-agent"},
        "publish": {"const": "managed-repair-publish"}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_only"],
      "properties": {"draft_only": {"const": true}}
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"const": "1.0"},
        "maximum": {"const": "1.x"}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "sha"],
      "properties": {
        "repository": {"const": "Ian-Tseng/analyze-project-claims"},
        "path": {"const": ".github/workflows/managed-skill-repair.yml"},
        "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    }
  }
}
