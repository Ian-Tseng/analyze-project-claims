{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ian-Tseng/analyze-project-claims/skill-quality-evaluation-manifest.schema.json",
  "title": "Skill Quality Evaluation Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "evaluation_id", "problem_signature_sha256",
    "baseline_package", "candidate_package", "fixtures", "environment", "model",
    "rules", "created_at_utc", "manifest_digest_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "skill-quality-evaluation"},
    "evaluation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "problem_signature_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_package": {"$ref": "#/$defs/package"},
    "candidate_package": {"$ref": "#/$defs/package"},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/fixture"}
    },
    "environment": {"$ref": "#/$defs/environment"},
    "model": {"$ref": "#/$defs/model"},
    "rules": {"$ref": "#/$defs/rules"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "manifest_digest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "repository", "skill", "version", "package_digest_sha256"],
      "properties": {
        "owner": {"const": "Ian-Tseng"},
        "repository": {"$ref": "#/$defs/identifier"},
        "skill": {"$ref": "#/$defs/identifier"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
        "package_digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id", "fixture_digest_sha256", "taxonomy_id", "capability_id",
        "environment_class", "invariant_id", "producer_repository", "quality_signal"
      ],
      "properties": {
        "fixture_id": {"$ref": "#/$defs/identifier"},
        "fixture_digest_sha256": {"$ref": "#/$defs/sha256"},
        "taxonomy_id": {"$ref": "#/$defs/identifier"},
        "capability_id": {"$ref": "#/$defs/identifier"},
        "environment_class": {"$ref": "#/$defs/identifier"},
        "invariant_id": {"$ref": "#/$defs/identifier"},
        "producer_repository": {"$ref": "#/$defs/identifier"},
        "quality_signal": {
          "enum": [
            "claim_evidence_gap", "documentation_mismatch",
            "internal_failure", "lifecycle_inconsistency"
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_id", "runner_image_digest_sha256", "dependency_lock_digest_sha256"],
      "properties": {
        "platform_id": {"$ref": "#/$defs/identifier"},
        "runner_image_digest_sha256": {"$ref": "#/$defs/sha256"},
        "dependency_lock_digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "parameters_digest_sha256", "pinned"],
      "properties": {
        "provider": {"$ref": "#/$defs/identifier"},
        "model": {"$ref": "#/$defs/identifier"},
        "parameters_digest_sha256": {"$ref": "#/$defs/sha256"},
        "pinned": {"type": "boolean"}
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleset_id", "ruleset_digest_sha256", "repetitions",
        "minimum_receipt_count", "maximum_receipt_count",
        "minimum_baseline_reproducibility_basis_points",
        "maximum_false_cluster_basis_points",
        "minimum_improvement_basis_points", "maximum_regression_basis_points"
      ],
      "properties": {
        "ruleset_id": {"$ref": "#/$defs/identifier"},
        "ruleset_digest_sha256": {"$ref": "#/$defs/sha256"},
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 100},
        "minimum_receipt_count": {"type": "integer", "minimum": 1, "maximum": 256},
        "maximum_receipt_count": {"type": "integer", "minimum": 1, "maximum": 256},
        "minimum_baseline_reproducibility_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "maximum_false_cluster_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "minimum_improvement_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "maximum_regression_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    }
  }
}
