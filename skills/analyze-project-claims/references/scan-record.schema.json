{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/analyze-project-claims/scan-record.schema.json",
  "title": "Analyze Project Claims Scan Record Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "scope",
    "authority",
    "components",
    "strongest_safe_claim",
    "claim_boundary",
    "unresolved_uncertainties"
  ],
  "properties": {
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "items": {"type": "string"}},
    "authority": {"type": "array", "items": {"type": "string"}},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "strongest_safe_claim": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1},
    "unresolved_uncertainties": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "component_type", "elements"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "component_type": {"type": "string", "minLength": 1},
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/element"}
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_id",
        "target",
        "method",
        "check_status",
        "claim_status",
        "evidence",
        "safe_interpretation",
        "required_repair"
      ],
      "properties": {
        "element_id": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "method": {
          "enum": [
            "inspected",
            "schema_validated",
            "executed_test",
            "replayed",
            "inferred",
            "not_tested"
          ]
        },
        "check_status": {"enum": ["PASS", "FAIL", "PARTIAL", "PENDING", "NA", "BLOCKED"]},
        "claim_status": {
          "enum": [
            "supported",
            "partially_supported",
            "contradicted",
            "untested",
            "invalidly_specified",
            "not_applicable"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "locator", "observed"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "locator": {"type": "string", "minLength": 1},
              "observed": {}
            }
          }
        },
        "safe_interpretation": {"type": "string", "minLength": 1},
        "required_repair": {"type": ["string", "null"]}
      }
    }
  }
}
