{
  "description": "Optional bounded cross-skill receipt handoff for analyze-project-claims.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/skills/analyze-project-claims/scripts/skill_quality_loop.py\" --format json --state-dir \"$PLUGIN_DATA/skill-quality\" hook-stop",
            "commandWindows": "py -3 -c \"import os,runpy,sys; p=os.path.join(os.environ['PLUGIN_ROOT'],'skills','analyze-project-claims','scripts','skill_quality_loop.py'); sys.path.insert(0,os.path.dirname(p)); sys.argv=[p,'--format','json','--state-dir',os.path.join(os.environ['PLUGIN_DATA'],'skill-quality'),'hook-stop']; runpy.run_path(p,run_name='__main__')\"",
            "timeout": 5,
            "statusMessage": "Checking bounded skill receipt"
          }
        ]
      }
    ]
  }
}
